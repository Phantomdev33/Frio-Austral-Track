# Reference configuration: replace FRIO_HOST with your domain and provision DNS.
# Only Caddy is exposed publicly; Django listens on loopback.
{$FRIO_HOST:localhost} {
    tls {
        protocols tls1.3 tls1.3
    }
    handle_path /static/* {
        root * {$FRIO_STATIC_ROOT}
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:8000 {
            header_up X-Forwarded-Proto https
        }
    }
}
