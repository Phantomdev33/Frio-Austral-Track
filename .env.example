# Example only; load values into the process environment. Django does not auto-load this file.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-random-secret
# Base64 of 32 random bytes; retain the original key when migrating existing encrypted data.
FIELD_ENCRYPTION_KEY=replace-with-base64-key
DJANGO_ALLOWED_HOSTS=frio.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://frio.example.com
FRIO_HOST=frio.example.com
FRIO_STATIC_ROOT=C:/path/to/staticfiles
# Leave the default file backend for academic demonstrations; no external emails are sent.
