*.sqlite3
*.sqlite3-*
*.sqlite3.bak
*.db
*.db-journal
*.db-wal
*.db-shm
/local-data/

# Claves privadas y configuración personal; conservar la plantilla sin secretos
/.secrets/
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# Archivos generados al ejecutar la aplicación
/media/
/docs/
/emails/
/staticfiles/
/tmp/
/temp/
/output/
/dist/
/build/
*.egg-info/
*.log
*.tmp
*.bak

# Configuración personal del editor y archivos del sistema operativo
/.vscode/
/.idea/
/.vs/
/.codex/
/.agents/
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
iniciar.bat

# Se conservan el código, migraciones, plantillas, recursos estáticos,
# README, requirements.txt, iniciar.bat, DDL, documentación y pruebas.
